# Copy to .env.local for local dev (vercel dev), and set the same in Vercel → Project → Settings → Environment Variables.

# Required — your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — set a shared passcode to gate the link (testers must send it). Leave blank/unset to keep the link open.
ACCESS_CODE=
