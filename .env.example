# Copy to .env.local for local dev (vercel dev), and set the same in Vercel → Project → Settings → Environment Variables.

# Required — your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — shared members-only password. The site's gate sends it as the x-access-code header; any
# request whose header doesn't match gets a 401 BEFORE any Anthropic call (wrong/no password costs $0).
# Visitor name + email are written to the Vercel logs. Set the real value in
# Vercel → Settings → Environment Variables — do NOT commit it here. Leave unset to keep the link open.
ACCESS_CODE=
