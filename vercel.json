{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/critique.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "data/voice-pack.md"
    },
    "api/feedback.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/ai-delegation-system",
      "destination": "https://rem-ai-systems.vercel.app/ai-delegation-system"
    },
    {
      "source": "/ai-delegation-system/:path*",
      "destination": "https://rem-ai-systems.vercel.app/ai-delegation-system/:path*"
    }
  ]
}
